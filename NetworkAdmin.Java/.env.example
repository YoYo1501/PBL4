# Copy to .env.local and replace values for your machine.
NETWORKADMIN_TLS_KEYSTORE_PATH=D:\path\to\NetworkAdmin.Java\local-test.p12
NETWORKADMIN_TLS_KEYSTORE_PASSWORD=replace-with-local-keystore-password
NETWORKADMIN_TLS_SERVER_SHA256=replace-with-SHA256-of-local-test.cer
NETWORKADMIN_SERVER_HOST=127.0.0.1
NETWORKADMIN_SERVER_PORT=5000
NETWORKADMIN_SCREEN_HOST=127.0.0.1
