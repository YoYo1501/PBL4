<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetworkAdminTool</RootNamespace>
    <AssemblyName>NetworkAdminTool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NetworkAdmin.Shared\NetworkAdmin.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="NetworkAdmin.Client\**\*.cs" />
    <Compile Remove="NetworkAdmin.Server\**\*.cs" />
    <Compile Remove="NetworkAdmin.Shared\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="NetworkAdmin.Client\Services\SystemMonitorService.cs" Link="Services\SystemMonitorService.cs" />
    <Compile Include="NetworkAdmin.Client\Services\NetworkInfoService.cs" Link="Services\NetworkInfoService.cs" />
    <Compile Include="NetworkAdmin.Client\Services\PingService.cs" Link="Services\PingService.cs" />
    <Compile Include="NetworkAdmin.Client\Services\NetworkScannerService.cs" Link="Services\NetworkScannerService.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
